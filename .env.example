# PunarShakti AI — Environment Variables
# Copy this file to .env and fill in values

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- CORS ----
# Comma-separated list of allowed origins
FRONTEND_URL=http://localhost:3000

# ---- Model Paths ----
ELECTRICAL_MODEL_PATH=models/electrical_model.joblib
ELECTRICAL_PREPROCESSOR_PATH=models/electrical_preprocessor.joblib
THERMAL_MODEL_PATH=models/thermal_model.pt
XRAY_MODEL_PATH=models/xray_model.pt

# ---- System ----
MODEL_VERSION=1.0.0
LOG_LEVEL=INFO
